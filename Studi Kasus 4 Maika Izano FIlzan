buku = {
    "judul": "Sejarah Kelam Ace Anthem",
    "penulis": "Andi Hebat",
    "tahun_terbit": 2024
}

while True:
    print("\n=== MENU PENGELOLAAN DATA BUKU ===")
    print("1. Tampilkan Data Buku")
    print("2. Tambah Penerbit")
    print("3. Ubah Penulis")
    print("4. Hapus Penerbit")
    print("5. Keluar")
    
    pilihan = input("Pilih menu (1-5): ")

    if pilihan == "1":
        print("\n--- Data Buku ---")
        for key, value in buku.items():
            print(f"{key}: {value}")

    elif pilihan == "2":
        penerbit_baru = input("Masukkan nama penerbit: ")
        buku["penerbit"] = penerbit_baru
        print("-> Penerbit berhasil ditambahkan!")

    elif pilihan == "3":
        penulis_baru = input("Masukkan nama penulis baru: ")
        buku["penulis"] = penulis_baru
        print("-> Data penulis berhasil diubah!")

    elif pilihan == "4":
        if "penerbit" in buku:
            del buku["penerbit"]
            print("-> Data penerbit berhasil dihapus!")
        else:
            print("-> Data penerbit belum ada di dictionary.")

    elif pilihan == "5":
        print("\n=== PROGRAM SELESAI ===")
        print("Data Buku Akhir:")
        for key, value in buku.items():
            print(f"- {key}: {value}")
        break

    else:
        print("-> Pilihan tidak valid, silakan coba lagi.")
